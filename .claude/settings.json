{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npm audit *)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(gh issue *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr create *)",
      "Bash(gh pr review --comment *)"
    ],
    "deny": [
      "Edit(/config/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Read(/.env*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review --approve *)",
      "Bash(git push --force *)",
      "Bash(git push * main)",
      "Bash(git push origin main *)",
      "Bash(npm install *)",
      "Bash(vercel *)"
    ]
  }
}
